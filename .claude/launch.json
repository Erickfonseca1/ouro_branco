{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototipo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "prototipo"
      ],
      "port": 4173
    },
    {
      "name": "jogo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "jogo",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}